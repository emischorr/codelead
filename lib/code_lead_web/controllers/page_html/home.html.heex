<Layouts.flash_group flash={@flash} />
<div class="flex min-h-screen items-center justify-center bg-desk px-4">
  <div class="flex w-full max-w-md flex-col items-center gap-4 rounded-2xl border border-border bg-surface p-8 text-center">
    <div class="flex size-10 items-center justify-center rounded-xl bg-accent">
      <svg width="20" height="20" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="2" y="2" width="4" height="10" rx="1.2" fill="#fff" />
        <rect x="8" y="2" width="4" height="6" rx="1.2" fill="#fff" opacity="0.75" />
      </svg>
    </div>
    <h1 class="text-lg font-bold text-text">Welcome to CodeLead</h1>
    <p class="text-sm leading-relaxed text-text2">
      No projects exist yet. Create one from an IEx shell to get started:
    </p>
    <pre
      class="w-full overflow-x-auto rounded-lg bg-term-bg p-4 text-left font-mono text-xs leading-relaxed text-term-text"
      phx-no-curly-interpolation
    >CodeLead.Projects.create_project(%{name: "My Project"})</pre>
    <p class="text-xs text-text3">
      Or run <span class="font-mono">mix ecto.reset</span> to load the demo seeds.
    </p>
  </div>
</div>
