POSTGRES_PW=""
APP_DB_PW=""

# can be generated via: openssl rand -hex 64
SECRET_KEY_BASE=""

# can be generated via: openssl rand -base64 32
# BACK THIS UP. Without it those rows are unreadable, and a fresh key does
# not recover them
ENCRYPTION_KEY=""

# the host's docker group id: stat -c '%g' /var/run/docker.sock
DOCKER_GID=""

# signed license key — container execution needs one (docs/licensing.md)
LICENSE_KEY=""

# --- Mail (optional) ---
# Email is off unless SMTP_HOST is set. Off means no magic-link login and no
# magic-link invites — accounts are username + password only.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
# STARTTLS policy: always | never | if_available
#SMTP_TLS=if_available
# true for implicit TLS (usually port 465)
#SMTP_SSL=false
# Sender the relay accepts. Defaults to codelead@$PHX_HOST
#MAIL_FROM=codelead@example.com
#MAIL_FROM_NAME=CodeLead